# Flask Configuration
SECRET_KEY=your_flask_secret_key_here_generate_with_secrets_token_hex
# Set to true once served over HTTPS - the session cookie is then only sent
# over TLS. Leave false for local http:// development or login breaks.
SESSION_COOKIE_SECURE=false

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Mail Server Configuration (Gmail SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_DEFAULT_SENDER=your_gmail_address@gmail.com

# OpenWeatherMap API Key
WEATHER_API_KEY=your_openweathermap_api_key
WEATHER_CITY=Malabon

# Seed account passwords (used only the first time the DB is initialized).
# The built-in fallbacks are publicly known from this repo - always set
# these explicitly for any deployment beyond local dev.
DEFAULT_ADMIN_PASSWORD=change_me_admin
DEFAULT_STAFF_PASSWORD=change_me_staff
DEFAULT_CUSTOMER_PASSWORD=change_me_customer

# How many days a cancelled booking stays in the live Cancelled list/table
# before being moved into reservations_archive (see cleanup.py). Optional -
# defaults to 14 if unset.
CANCELLED_BOOKING_RETENTION_DAYS=14
